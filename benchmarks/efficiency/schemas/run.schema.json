    "arm": {"enum": ["DIRECT", "DEPUTY"]},
    "repetition": {"type": "integer", "minimum": 1},
    "supervisor": {"$ref": "#/$defs/supervisor"},
    "context": {"$ref": "#/$defs/context"},
    "delegate": {"$ref": "#/$defs/delegate"},
    "execution": {"$ref": "#/$defs/execution"},
    "result": {"$ref": "#/$defs/result"},
    "total_inference_tokens": {"type": ["integer", "null"], "minimum": 0}
  },
  "$defs": {
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "supervisor": {"type": "object", "required": ["model", "reasoning_effort", "input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens", "token_telemetry"], "properties": {"model": {"type": "string"}, "reasoning_effort": {"type": "string"}, "input_tokens": {"$ref": "#/$defs/nullableCount"}, "cached_input_tokens": {"$ref": "#/$defs/nullableCount"}, "cache_write_input_tokens": {"$ref": "#/$defs/nullableCount"}, "output_tokens": {"$ref": "#/$defs/nullableCount"}, "reasoning_output_tokens": {"$ref": "#/$defs/nullableCount"}, "total_tokens": {"$ref": "#/$defs/nullableCount"}, "token_telemetry": {"enum": ["MEASURED", "UNMEASURED"]}}, "additionalProperties": true},
    "context": {"type": "object", "required": ["model_context_window", "baseline_context_tokens", "peak_context_tokens", "context_growth_tokens", "peak_context_percent", "compaction_count", "decision_context_tokens", "decision_context_remaining", "telemetry"], "properties": {"model_context_window": {"$ref": "#/$defs/nullableCount"}, "baseline_context_tokens": {"$ref": "#/$defs/nullableCount"}, "peak_context_tokens": {"$ref": "#/$defs/nullableCount"}, "context_growth_tokens": {"$ref": "#/$defs/nullableCount"}, "peak_context_percent": {"type": ["number", "null"], "minimum": 0}, "compaction_count": {"$ref": "#/$defs/nullableCount"}, "decision_context_tokens": {"$ref": "#/$defs/nullableCount"}, "decision_context_remaining": {"$ref": "#/$defs/nullableCount"}, "telemetry": {"enum": ["MEASURED", "PARTIAL", "UNMEASURED"]}}, "additionalProperties": true},
    "delegate": {"type": "object", "required": ["provider", "model", "input_tokens", "cache_read_tokens", "cache_write_tokens", "output_tokens", "reasoning_tokens", "token_telemetry"], "properties": {"provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "input_tokens": {"$ref": "#/$defs/nullableCount"}, "cache_read_tokens": {"$ref": "#/$defs/nullableCount"}, "cache_write_tokens": {"$ref": "#/$defs/nullableCount"}, "output_tokens": {"$ref": "#/$defs/nullableCount"}, "reasoning_tokens": {"$ref": "#/$defs/nullableCount"}, "token_telemetry": {"enum": ["NOT_APPLICABLE", "MEASURED", "PARTIAL", "UNMEASURED"]}}, "additionalProperties": true},
    "execution": {"type": "object", "required": ["supervisor_turns", "supervisor_tool_calls", "mcp_calls", "agents_calls", "workers_calls", "wall_clock_ms"], "properties": {"supervisor_turns": {"type": "integer", "minimum": 0}, "supervisor_tool_calls": {"type": "integer", "minimum": 0}, "mcp_calls": {"type": "integer", "minimum": 0}, "agents_calls": {"type": "integer", "minimum": 0}, "workers_calls": {"type": "integer", "minimum": 0}, "wall_clock_ms": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "result": {"type": "object", "required": ["status", "grader_checks", "failure_reason"], "properties": {"status": {"enum": ["PASS", "FAIL", "BLOCKED", "BENCHMARK_PROTOCOL_VIOLATION"]}, "grader_checks": {"type": "object"}, "failure_reason": {"type": ["string", "null"]}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
