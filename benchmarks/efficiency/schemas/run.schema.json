{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deputy.mcp.efficiency-run.v1",
  "type": "object",
  "required": ["schema", "benchmark_version", "case_id", "arm", "repetition", "supervisor", "context", "delegate", "execution", "result"],
  "properties": {
    "schema": {"const": "deputy.mcp.efficiency-run.v1"},
